# TaDa frontend — environment template.
# Copy to .env.local and fill in: cp .env.example .env.local
#
# Anything prefixed with NEXT_PUBLIC_ is inlined into the bundle and visible in
# the browser. No secrets belong here.

# ─── Site environment ─────────────────────────────────────────────────────────
# The ONLY switch that makes the site indexable (robots.txt Allow + no
# noindex meta). Set to "production" in the Vercel Production environment
# scope and nowhere else. Falls back to NEXT_PUBLIC_VERCEL_ENV for backward
# compatibility, but that twin exists only when Vercel's "Automatically
# expose System Environment Variables" is enabled - set this one explicitly.
NEXT_PUBLIC_SITE_ENV=

# ─── API ──────────────────────────────────────────────────────────────────────
# Backend base URL including the /api prefix.
# Production: https://ta-da.co/api — staging: https://stage.ta-da.co/api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ─── Analytics (GA4) ──────────────────────────────────────────────────────────
# Measurement id of the production GA4 property, e.g. G-XXXXXXXXXX.
#
# Set it ONLY in the Vercel "Production" environment scope. stage.ta-da.co is a
# branch deployment of this same project, so leaving it unset everywhere else is
# what keeps staging traffic out of the production property. Analytics also
# refuses to start unless NEXT_PUBLIC_VERCEL_ENV is "production" (Vercel sets
# this automatically) and the hostname is ta-da.co or www.ta-da.co — see
# src/lib/analytics/ga.ts. Leave empty locally: with no id, nothing is loaded
# and every event is a no-op.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── E2E (Playwright) ─────────────────────────────────────────────────────────
# Only needed when running e2e; normal development leaves them unset and
# playwright.config.ts falls back to these same defaults.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_API_URL=http://localhost:5001/api
