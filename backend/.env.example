# TaDa backend — environment template.
# Copy to .env and fill in: cp .env.example .env
# Everything below is a placeholder; real secrets live in .env (gitignored).
#
# This list is derived from the code, not copied from an existing .env:
# variables nothing reads are kept in a separate block at the bottom.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Port Nest listens on. Overridden to 3001 in Docker (see docker-compose.yml).
PORT=5001
# Used for redirects back to the app after Google OAuth.
FRONTEND_URL=http://localhost:3000
# Used when the backend builds absolute links to itself.
BACKEND_URL=http://localhost:5001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# These are ADDED to the built-in list (localhost:3000, localhost:3001,
# ta-da.co, www.ta-da.co, stage.ta-da.co) — they do not replace it, so an empty
# or missing value keeps exactly the behaviour the hardcoded list had.
# See src/common/config/cors.config.ts for why it merges rather than replaces.
CORS_ORIGIN=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# true — connect over SSL with rejectUnauthorized: false (managed databases).
DB_SSL=false

# ─── TypeORM (development only) ───────────────────────────────────────────────
# synchronize turns on ONLY when NODE_ENV=development AND this flag is true.
# It is hard-disabled in production — the schema is changed by migrations
# (npm run mig:run:prod).
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret. In production use a long random string, not this one.
JWT_SECRET=change-me-in-production

# Token lifetimes. Both are optional: the values below are also the defaults
# compiled into the code (src/common/config/auth-tokens.config.ts), so a host
# that sets neither still gets a 15-minute access token and a 30-day session.
# Format is the jsonwebtoken one — 15m, 12h, 30d; a bare number means seconds.
# An unparseable value is ignored in favour of the default.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth — the only way to sign in. There is no password login.
# The callback must match the one registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# ─── S3 (property and building media) ─────────────────────────────────────────
AWS_REGION=eu-west-2
# The code reads AWS_S3_BUCKET; AWS_S3_BUCKET_NAME is only a legacy fallback,
# so fill in AWS_S3_BUCKET.
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Notifications (internal alerts to support) ───────────────────────────────
# Domain events (registration, tenant CV completed, booking request) are turned
# into emails to a FIXED internal address. No value here ever comes from a
# request body — the service cannot be pointed at an arbitrary inbox.
#
# Missing configuration is not fatal: with no AWS credentials the email
# transport degrades to log-only, exactly like S3Service does for uploads. That
# is the intended local-development state — leave the AWS_SES_* lines empty.

# Master kill switch. "false" stops recording AND sending immediately, with no
# redeploy. Unset means enabled.
NOTIFICATIONS_ENABLED=true

# Per-channel switch. Turning this off leaves rows queued in the notifications
# table (they are retried once it is back on) rather than dropping them.
EMAIL_ENABLED=true

# Envelope sender. MUST be verified in SES in the region below, or every send
# fails with MessageRejected.
NOTIFICATIONS_FROM=no-reply@ta-da.co

# The only destination. Defaults to support@ta-da.co when unset.
NOTIFICATIONS_TO=support@ta-da.co

# Whether a re-submitted booking request notifies again. A tenant may re-submit
# the same property (the row is updated, not inserted, because of the
# tenant+property unique constraint). Unset means yes.
NOTIFY_ON_BOOKING_RESUBMIT=true

# SES credentials. Leave BOTH empty to reuse AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY from the S3 block above — that is the intended setup,
# and it requires adding the ses:SendEmail permission to that IAM identity.
# Fill these in only if SES should use a separate, narrower identity.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Region SES sends from. Falls back to AWS_REGION, then eu-west-2.
# The sender identity must be verified in THIS region specifically.
AWS_SES_REGION=eu-west-2

# ─── Swagger ──────────────────────────────────────────────────────────────────
# With NODE_ENV=production, /api/docs sits behind basic auth and main.ts compares
# the submitted credentials against these two variables directly.
# Both are REQUIRED in production: if either is missing, the comparison can never
# succeed and /api/docs answers 401 to everyone, including you. Neither is set on
# the hosts today, so the production docs are currently unreachable.
# In development NODE_ENV is not "production", the check is skipped and the docs
# are open — leaving these empty locally is fine.
SWAGGER_USER=
SWAGGER_PASSWORD=

# ─── Monitoring ───────────────────────────────────────────────────────────────
# Empty — Sentry is not initialised and the app runs as usual.
SENTRY_DSN=

# ─── Only for scripts/seed-stage-units.mjs ────────────────────────────────────
# A one-off staging seeding script; the application itself does not need these.
API_URL=http://localhost:5001/api
AUTH_TOKEN=

# ─── No longer read by any code ───────────────────────────────────────────────
# Kept here as a record: these appear in the .env files on the hosts, but no line
# of code reads them. Removed in step 3.2 of the refactoring plan.
#
#   REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB
#       Redis was removed from the code (PR #44) and from docker-compose.yml
#       (step 3.2). Step 3.1 confirmed these four are still present in
#       /opt/tada/.env on prod and stage — delete them there once this change is
#       deployed, together with the tada-redis container and its volume.
#   BCRYPT_ROUNDS, SESSION_CLEANUP_INTERVAL, MAX_SESSIONS_PER_DEVICE
#       Leftovers from password auth and server-side sessions, neither of which exist.
